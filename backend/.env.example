# SOMEE - Main SQL Server database (placeholders only)
sqlServerVersion="MS SQL 2025 Express"
sqlServerAddress="your-server.mssql.somee.com"
loginName="your_sql_login"
loginPassword="your_sql_password"
sqlServerPort=1433
connectionString="workstation id=your-server.mssql.somee.com;packet size=4096;user id=your_sql_login;pwd=your_sql_password;data source=your-server.mssql.somee.com;persist security info=False;initial catalog=VolunteerConnect;TrustServerCertificate=True"

# The SQLAlchemy URI uses Encrypt=yes and TrustServerCertificate=yes because
# Somee's certificate often cannot be validated. Traffic is encrypted, but the
# server identity is not verified.

# SUPABASE - Vector database (not used by authentication)

vectorDBPassword="your_vector_db_password"
vectorDBConnectionString="postgresql://postgres:your_vector_db_password@db.example.supabase.co:5432/postgres"
vectorDBId="your_vector_db_id"

JWT_SECRET_KEY="change-me"
FRONTEND_ORIGIN="http://localhost:5173"
FLASK_DEBUG=false
